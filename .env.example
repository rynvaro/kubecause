# KubeCause 环境变量示例
# 用法：cp .env.example .env，再填真实值；.env 不要提交到仓库。
# Key 只从环境变量读，不要写进代码、README 或任何提交的文件。
# 启动时直接在命令行传环境变量即可，例如：
#   MODEL_API_KEY="sk-..." KUBE_MODE=kind MODEL_MODE=real go run ./cmd/server

# 模型模式：stub（桩模型，默认）或 real（真模型）
MODEL_MODE=stub
# 真模型 API Key，MODEL_MODE=real 时必填
MODEL_API_KEY=
# 真模型地址，默认 DeepSeek；换 OpenAI 时改成 https://api.openai.com/v1
MODEL_BASE_URL=https://api.deepseek.com/v1
# 真模型名，默认 deepseek-chat；换 OpenAI 时改成 gpt-4o-mini 等
MODEL_NAME=deepseek-chat

# K8s 模式：fake（默认，假客户端）或 kind（真集群，读 kubeconfig）
KUBE_MODE=fake
# kind 模式下指定 kubeconfig，不填用 ~/.kube/config
KUBECONFIG=

# SQLite 文件路径和监听地址
DB_PATH=./kubecause.db
ADDR=:8080
